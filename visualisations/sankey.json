    },
    {
      "name": "state_nodes",
      "source": "nodes",
      "transform": [{"type": "filter", "expr": "datum.kind === 'state'"}]
    },
    {
      "name": "stream_nodes",
      "source": "nodes",
      "transform": [{"type": "filter", "expr": "datum.kind === 'stream'"}]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {"data": "links"},
      "zindex": 0,
      "encode": {
        "enter": {
          "path": {"field": "path"},
          "fill": {"field": "color"},
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 0.35},
          "strokeOpacity": {"value": 0.18},
          "tooltip": {
            "signal": "{'Migration stream': datum.stream, 'State / territory': datum.state, 'Settlers': format(datum.settlers, ','), 'Share of stream': format(datum.stream_share_pct, '.1f') + '%', 'Share of state settlers': format(datum.state_share_pct, '.1f') + '%'}"
          }
        },
        "update": {"fillOpacity": {"value": 0.58}},
        "hover": {"fillOpacity": {"value": 0.88}}
      }
    },
    {
      "type": "rect",
      "from": {"data": "nodes"},
      "zindex": 2,
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "x2": {"field": "x2"},
          "y": {"field": "y"},
          "y2": {"field": "y2"},
          "fill": {"field": "fill"},
          "cornerRadius": {"value": 2},
          "tooltip": {
            "signal": "{'Category': datum.name, 'Settlers': format(datum.total, ',')}"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {"data": "state_nodes"},
      "interactive": false,
      "zindex": 1,
      "encode": {
        "enter": {
          "x": {"signal": "datum.x2 + 4"},
          "x2": {"value": 798},
          "y": {"signal": "(datum.y + datum.y2) / 2"},
          "y2": {"field": "label_y"},
          "stroke": {"value": "#CBD0D6"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "stream_nodes"},
      "zindex": 3,
      "encode": {
        "enter": {
          "x": {"field": "label_x"},
          "y": {"field": "label_y"},
          "text": {"field": "name"},
          "align": {"value": "right"},
          "baseline": {"value": "bottom"},
          "font": {"value": "Arial"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#1F2937"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "stream_nodes"},
      "interactive": false,
      "zindex": 3,
      "encode": {
        "enter": {
          "x": {"field": "label_x"},
          "y": {"signal": "datum.label_y + 4"},
          "text": {"signal": "format(datum.total, ',')"},
          "align": {"value": "right"},
          "baseline": {"value": "top"},
          "font": {"value": "Arial"},
          "fontSize": {"value": 10},
          "fill": {"value": "#6B7280"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "state_nodes"},
      "zindex": 3,
      "encode": {
        "enter": {
          "x": {"field": "label_x"},
          "y": {"field": "label_y"},
          "text": {"field": "name"},
          "align": {"value": "left"},
          "baseline": {"value": "bottom"},
          "font": {"value": "Arial"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#1F2937"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "state_nodes"},
      "interactive": false,
      "zindex": 3,
      "encode": {
        "enter": {
          "x": {"field": "label_x"},
          "y": {"signal": "datum.label_y + 4"},
          "text": {"signal": "format(datum.total, ',')"},
          "align": {"value": "left"},
          "baseline": {"value": "top"},
          "font": {"value": "Arial"},
          "fontSize": {"value": 10},
          "fill": {"value": "#6B7280"}
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "enter": {
          "x": {"value": 186},
          "y": {"value": 60},
          "text": {"value": "MIGRATION STREAM"},
          "align": {"value": "center"},
          "font": {"value": "Arial"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#6B7280"}
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "enter": {
          "x": {"value": 756},
