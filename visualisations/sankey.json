{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 1080,
  "height": 620,
  "padding": {"left": 20, "right": 20, "top": 20, "bottom": 20},
  "background": "white",
  "title": {
    "text": "How do migration streams distribute across Australia?",
    "subtitle": [
      "Permanent settlers by migration stream and current state/territory, 2016–2025",
      "Flow width represents number of settlers. Not Recorded destinations are excluded."
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 22,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "color": "#17283b",
    "subtitleColor": "#4b5563",
    "offset": 12
  },
  "data": [
    {
      "name": "links",
      "url": "https://raw.githubusercontent.com/Braulio7274/FIT3179---Data-visualisation-2/refs/heads/main/migration_stream_state_sankey.csv",
      "format": {
        "type": "csv",
        "parse": {
          "settlers": "number",
          "stream_total": "number",
          "state_total": "number",
          "stream_share_pct": "number",
          "state_share_pct": "number"
        },
        "delimiter": ","
      }
    },
    {
