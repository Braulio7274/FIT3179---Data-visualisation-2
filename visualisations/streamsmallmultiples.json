    },
    {
      "type": "shape",
      "from": {
        "data": "states"
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "skilledProjection"
        }
      ],
      "encode": {
        "enter": {
          "fill": {
            "scale": "skilledColor",
            "field": "SkilledShare"
          },
          "stroke": {
            "value": "#FFF7ED"
          },
          "strokeWidth": {
            "value": 1.4
          },
          "tooltip": {
            "signal": "{'State / territory': datum.properties.STATE_NAME, 'Share of Skilled stream': format(datum.SkilledShare, '.1f') + '%', 'Skilled settlers': format(datum.SkilledTotal, ',')}"
          }
        },
        "update": {
          "fillOpacity": {
            "value": 1
          },
          "stroke": {
            "value": "#FFF7ED"
          },
          "strokeWidth": {
            "value": 1.4
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.72
          },
          "stroke": {
            "value": "#4A2545"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
