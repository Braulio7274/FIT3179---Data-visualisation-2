          },
          "strokeWidth": {
            "value": 1.4
          },
          "tooltip": {
            "signal": "{'State / territory': datum.properties.STATE_NAME, 'Share of Family stream': format(datum.FamilyShare, '.1f') + '%', 'Family settlers': format(datum.FamilyTotal, ',')}"
          }
        },
        "update": {
          "fillOpacity": {
            "value": 1
          },
          "stroke": {
            "value": "#FFF7ED"
          },
          "strokeWidth": {
            "value": 1.4
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.72
          },
          "stroke": {
            "value": "#4A2545"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "shape",
      "from": {
        "data": "states"
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "humanitarianProjection"
        }
      ],
      "encode": {
        "enter": {
          "fill": {
            "scale": "humanitarianColor",
            "field": "HumanitarianShare"
