          "text": {
            "value": "Skilled"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Space Grotesk"
          },
          "fontSize": {
            "value": 17
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#315B7D"
          }
        }
      }
    },
    {
