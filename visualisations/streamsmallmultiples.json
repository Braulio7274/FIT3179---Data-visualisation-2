{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Small-multiple maps comparing how Australia's Skilled, Family and Humanitarian migration streams are distributed across states and territories.",
  "width": 1120,
  "height": 510,
  "padding": {
    "left": 20,
    "right": 20,
    "top": 20,
    "bottom": 20
  },
  "autosize": "pad",
  "background": "#FFF7ED",
  "data": [
    {
      "name": "settlement",
      "url": "https://raw.githubusercontent.com/Braulio7274/FIT3179---Data-visualisation-2/refs/heads/main/state_settlement_year.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Year": "number",
          "Settlers": "number",
          "Humanitarian": "number",
          "Family": "number",
          "Skilled": "number"
        }
      }
    },
    {
      "name": "state_totals",
      "source": "settlement",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "State"
          ],
          "fields": [
            "Skilled",
            "Family",
            "Humanitarian"
          ],
          "ops": [
            "sum",
            "sum",
            "sum"
          ],
          "as": [
            "SkilledTotal",
            "FamilyTotal",
            "HumanitarianTotal"
          ]
        },
        {
          "type": "joinaggregate",
          "fields": [
            "SkilledTotal",
            "FamilyTotal",
            "HumanitarianTotal"
          ],
          "ops": [
            "sum",
            "sum",
            "sum"
          ],
          "as": [
            "AustraliaSkilled",
            "AustraliaFamily",
            "AustraliaHumanitarian"
          ]
        },
        {
          "type": "formula",
          "as": "SkilledShare",
          "expr": "datum.AustraliaSkilled > 0 ? datum.SkilledTotal / datum.AustraliaSkilled * 100 : 0"
        },
        {
          "type": "formula",
          "as": "FamilyShare",
          "expr": "datum.AustraliaFamily > 0 ? datum.FamilyTotal / datum.AustraliaFamily * 100 : 0"
        },
        {
          "type": "formula",
          "as": "HumanitarianShare",
          "expr": "datum.AustraliaHumanitarian > 0 ? datum.HumanitarianTotal / datum.AustraliaHumanitarian * 100 : 0"
        }
      ]
    },
    {
      "name": "states",
      "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/refs/heads/master/states.geojson",
      "format": {
        "type": "json",
        "property": "features"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.properties.STATE_NAME != 'Other Territories'"
        },
        {
          "type": "lookup",
          "from": "state_totals",
          "key": "State",
          "fields": [
            "properties.STATE_NAME"
          ],
          "values": [
            "SkilledShare",
            "FamilyShare",
            "HumanitarianShare",
            "SkilledTotal",
            "FamilyTotal",
            "HumanitarianTotal"
          ],
          "as": [
            "SkilledShare",
            "FamilyShare",
            "HumanitarianShare",
            "SkilledTotal",
            "FamilyTotal",
            "HumanitarianTotal"
          ],
          "default": 0
        }
      ]
    },
    {
      "name": "state_labels",
      "values": [
        {
          "abbr": "WA",
          "lon": 122.5,
          "lat": -25.5,
          "dx": 0,
          "dy": 0
        },
        {
          "abbr": "NT",
          "lon": 133.2,
          "lat": -19.7,
          "dx": 0,
          "dy": 0
        },
        {
          "abbr": "SA",
          "lon": 135.2,
          "lat": -30.2,
          "dx": 0,
          "dy": 0
        },
        {
          "abbr": "QLD",
          "lon": 144.4,
          "lat": -23.1,
          "dx": 0,
          "dy": 0
        },
        {
          "abbr": "NSW",
          "lon": 147.1,
          "lat": -32.4,
          "dx": 0,
          "dy": 0
        },
        {
          "abbr": "VIC",
          "lon": 144.8,
          "lat": -37.2,
          "dx": 0,
          "dy": 0
        },
        {
          "abbr": "TAS",
          "lon": 146.6,
          "lat": -42,
          "dx": 0,
          "dy": 0
        },
        {
          "abbr": "ACT",
          "lon": 149.1,
          "lat": -35.3,
          "dx": 16,
          "dy": -4
        }
      ]
    },
    {
      "name": "skilled_labels",
      "source": "state_labels",
      "transform": [
        {
          "type": "geopoint",
          "projection": "skilledProjection",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    },
    {
      "name": "family_labels",
      "source": "state_labels",
      "transform": [
        {
          "type": "geopoint",
          "projection": "familyProjection",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    },
    {
      "name": "humanitarian_labels",
      "source": "state_labels",
      "transform": [
        {
          "type": "geopoint",
          "projection": "humanitarianProjection",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "skilledProjection",
      "type": "mercator",
      "center": [
        134,
        -28
      ],
      "scale": 355,
      "translate": [
        225,
        230
      ]
    },
    {
      "name": "familyProjection",
      "type": "mercator",
      "center": [
        134,
        -28
      ],
      "scale": 355,
      "translate": [
        560,
        230
      ]
    },
    {
      "name": "humanitarianProjection",
      "type": "mercator",
      "center": [
        134,
        -28
      ],
      "scale": 355,
      "translate": [
        895,
        230
      ]
    }
  ],
  "scales": [
    {
      "name": "skilledColor",
      "type": "linear",
      "domain": [
        0,
        40
      ],
      "range": [
        "#EDF4F8",
        "#315B7D"
      ],
      "zero": true,
      "nice": false,
      "clamp": true
    },
    {
      "name": "familyColor",
      "type": "linear",
      "domain": [
        0,
        40
      ],
      "range": [
        "#EDF6EA",
        "#43A829"
      ],
      "zero": true,
      "nice": false,
      "clamp": true
    },
    {
      "name": "humanitarianColor",
      "type": "linear",
      "domain": [
        0,
        40
      ],
      "range": [
        "#FAEEE5",
        "#D97A34"
      ],
      "zero": true,
      "nice": false,
      "clamp": true
    }
  ],
  "legends": [
    {
      "fill": "skilledColor",
      "title": "Share of Skilled stream",
      "orient": "none",
      "legendX": 112,
      "legendY": 408,
      "direction": "horizontal",
      "gradientLength": 225,
      "gradientThickness": 11,
      "values": [
        0,
        10,
        20,
        30,
        40
      ],
      "format": ".0f",
      "labelExpr": "datum.label + '%'",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "titleColor": "#4A2545",
      "labelFont": "Source Sans 3",
      "labelFontSize": 11,
      "labelFontWeight": 400,
      "labelColor": "#655A67",
      "titleLimit": 240
    },
    {
      "fill": "familyColor",
      "title": "Share of Family stream",
      "orient": "none",
      "legendX": 447,
      "legendY": 408,
      "direction": "horizontal",
      "gradientLength": 225,
      "gradientThickness": 11,
      "values": [
        0,
        10,
        20,
        30,
        40
      ],
      "format": ".0f",
      "labelExpr": "datum.label + '%'",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "titleColor": "#4A2545",
      "labelFont": "Source Sans 3",
      "labelFontSize": 11,
      "labelFontWeight": 400,
      "labelColor": "#655A67",
      "titleLimit": 240
    },
    {
      "fill": "humanitarianColor",
      "title": "Share of Humanitarian stream",
      "orient": "none",
      "legendX": 782,
      "legendY": 408,
      "direction": "horizontal",
      "gradientLength": 225,
      "gradientThickness": 11,
      "values": [
        0,
        10,
        20,
        30,
        40
      ],
      "format": ".0f",
      "labelExpr": "datum.label + '%'",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "titleColor": "#4A2545",
      "labelFont": "Source Sans 3",
      "labelFontSize": 11,
      "labelFontWeight": 400,
      "labelColor": "#655A67",
      "titleLimit": 250
    }
  ],
  "marks": [
