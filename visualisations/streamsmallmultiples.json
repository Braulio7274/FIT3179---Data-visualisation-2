          "fontSize": {
            "value": 17
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#43A829"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 895
          },
          "y": {
            "value": 65
          },
          "text": {
            "value": "Humanitarian"
          },
          "align": {
            "value": "center"
          },
          "font": {
