{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Selected major settler flows to Australian states with improved legend formatting and tooltips.",
  "width": 930,
  "height": 620,
  "padding": 12,
  "background": "#FFF7ED",

  "title": {
    "text": "Selected major settler flows to Australian states",
    "subtitle": [
      "Top 6 origin countries (excluding Australia) and their top 2 destination states, aggregated across Skilled, Family and Humanitarian streams, 2016–2025.",
      "Line width shows the number of settlers."
    ],
    "anchor": "start",
    "font": "Space Grotesk",
    "fontSize": 22,
    "fontWeight": 700,
    "color": "#4A2545",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#655A67",
    "subtitlePadding": 8,
    "offset": 16
  },

  "projection": {
    "type": "equalEarth",
    "center": [100, 12],
    "scale": 278,
    "translate": [455, 322]
  },

  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#D6D0C8",
        "stroke": "#AFA79D",
        "strokeWidth": 0.7
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Braulio7274/FIT3179---Data-visualisation-2/refs/heads/main/settler_flow_paths_simple.csv"
      },
      "transform": [
        {
          "calculate": "datum.origin_country + '-' + datum.destination_state",
          "as": "flow_id"
        }
      ],
      "mark": {
        "type": "line",
        "opacity": 0.52,
        "strokeCap": "round"
      },
      "encoding": {
        "detail": {
          "field": "flow_id"
        },
        "strokeDash": {
          "field": "flow_rank",
          "type": "ordinal",
          "legend": null
        },
        "order": {
          "field": "point_order",
          "type": "ordinal"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "settlers",
          "type": "quantitative",
          "scale": {
            "range": [1, 9]
          },
          "legend": {
            "title": "Settlers",
            "orient": "right",
            "offset": 12,
            "values": [0, 50000, 100000, 150000],
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value/1000, '.0f') + 'k'",
            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": 700,
            "titleColor": "#4A2545",
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#655A67"
          }
        },
        "color": {
          "field": "destination_state",
          "type": "nominal",
          "scale": {
            "domain": [
              "Victoria",
              "New South Wales",
              "Queensland",
              "Western Australia"
            ],
            "range": [
              "#1b9e77",
              "#7570b3",
              "#d95f02",
              "#66a61e"
            ]
          },
          "legend": {
            "title": "Destination state",
            "orient": "right",
            "offset": 12,
            "labelLimit": 220,
            "titleLimit": 220,
            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": 700,
            "titleColor": "#4A2545",
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#655A67"
          }
        },
        "tooltip": [
          {
            "field": "origin_label",
            "type": "nominal",
            "title": "Origin country"
          },
          {
            "field": "destination_state",
            "type": "nominal",
            "title": "Destination state"
          },
          {
            "field": "settlers",
            "type": "quantitative",
            "title": "Settlers",
            "format": ","
          },
          {
            "field": "country_total",
            "type": "quantitative",
            "title": "Total settlers from origin",
            "format": ","
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Braulio7274/FIT3179---Data-visualisation-2/refs/heads/main/settler_flow_paths_simple.csv"
      },
      "transform": [
        {
          "filter": "datum.point_type === 'origin'"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "max",
              "field": "lat",
              "as": "lat"
            },
            {
              "op": "max",
              "field": "country_total",
              "as": "country_total"
            }
          ],
          "groupby": ["origin_country", "origin_label"]
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "circle",
        "size": 85,
        "color": "#a54c49",
        "stroke": "white",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "origin_label",
            "type": "nominal",
            "title": "Origin country"
          },
          {
            "field": "country_total",
            "type": "quantitative",
            "title": "Total settlers from origin",
            "format": ","
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          { "name": "United Kingdom", "lon": -3.436, "lat": 55.3781 },
          { "name": "Pakistan", "lon": 69.3451, "lat": 30.3753 },
          { "name": "Nepal", "lon": 84.124, "lat": 28.3949 },
          { "name": "India", "lon": 78.9629, "lat": 22.5937 },
          { "name": "China", "lon": 104.1954, "lat": 35.8617 },
          { "name": "Philippines", "lon": 121.774, "lat": 12.8797 }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#7f1d1d",
        "dx": 6,
        "dy": -6,
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name"
        }
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Braulio7274/FIT3179---Data-visualisation-2/refs/heads/main/settler_flow_paths_simple.csv"
      },
      "transform": [
        {
          "filter": "datum.point_type === 'destination'"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "max",
              "field": "lat",
              "as": "lat"
            }
          ],
          "groupby": ["destination_state", "destination_abbr"]
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "diamond",
        "size": 135,
        "stroke": "white",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "destination_state",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Victoria",
              "New South Wales",
              "Queensland",
              "Western Australia"
            ],
            "range": [
              "#1b9e77",
              "#7570b3",
              "#d95f02",
              "#66a61e"
            ]
          }
        },
        "tooltip": [
          {
            "field": "destination_state",
            "type": "nominal",
            "title": "Destination state"
          },
          {
            "field": "destination_abbr",
            "type": "nominal",
            "title": "Abbreviation"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          { "abbr": "WA", "lon": 115.8605, "lat": -31.9505 },
          { "abbr": "VIC", "lon": 144.9631, "lat": -37.8136 },
          { "abbr": "NSW", "lon": 151.2093, "lat": -33.8688 },
          { "abbr": "QLD", "lon": 153.026, "lat": -27.4705 }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#4A2545",
        "dx": 8,
        "dy": 8,
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr"
        }
      }
    }
  ],

  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "labelFontSize": 11,
      "labelColor": "#655A67",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "titleColor": "#4A2545"
    },
    "title": {
      "font": "Space Grotesk",
      "fontSize": 22,
      "fontWeight": 700,
      "color": "#4A2545",
      "subtitleFont": "Source Sans 3",
      "subtitleFontSize": 12,
      "subtitleFontWeight": 400,
      "subtitleColor": "#655A67"
    }
  }
}
