{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Streamgraph showing annual national totals for Skilled, Family and Humanitarian permanent settlement streams in Australia from 2016 to 2025, with direct labels inside the bands.",
  "width": 980,
  "height": 420,
  "background": "#FFF7ED",
  "padding": {
    "left": 10,
    "right": 10,
    "top": 14,
    "bottom": 10
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Braulio7274/FIT3179---Data-visualisation-2/refs/heads/main/state_settlement_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Skilled": "number",
        "Family": "number",
        "Humanitarian": "number"
      }
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Skilled",
          "as": "Skilled"
        },
        {
          "op": "sum",
          "field": "Family",
          "as": "Family"
        },
        {
          "op": "sum",
          "field": "Humanitarian",
          "as": "Humanitarian"
        }
      ],
      "groupby": [
        "Year"
      ]
    },
    {
      "fold": [
        "Skilled",
        "Family",
        "Humanitarian"
      ],
      "as": [
        "Migration stream",
        "Settlers"
      ]
    },
    {
      "calculate": "datum['Migration stream'] === 'Skilled' ? 0 : datum['Migration stream'] === 'Family' ? 1 : 2",
      "as": "streamOrder"
    },
    {
      "stack": "Settlers",
      "groupby": [
        "Year"
      ],
      "sort": [
        {
          "field": "streamOrder",
          "order": "ascending"
        }
      ],
      "offset": "center",
      "as": [
        "y0",
        "y1"
      ]
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "labelY"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.9,
        "stroke": "#FFF7ED",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFont": "Source Sans 3",
            "labelFontSize": 12,
            "labelColor": "#655A67",
            "tickColor": "#DED3C8",
            "domainColor": "#DED3C8",
            "grid": false
          }
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "Migration stream",
          "type": "nominal",
          "scale": {
            "domain": [
              "Skilled",
              "Family",
              "Humanitarian"
            ],
            "range": [
              "#315B7D",
              "#43A829",
              "#D97A34"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Migration stream",
            "type": "nominal",
            "title": "Migration stream"
          },
          {
            "field": "Settlers",
            "type": "quantitative",
            "title": "Settlers",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year === 2023"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Space Grotesk",
        "fontSize": 13,
        "fontWeight": 700,
        "fill": "#FFF7ED",
        "stroke": "#4A2545",
        "strokeWidth": 0.45,
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "sort": "ascending"
        },
        "y": {
          "field": "labelY",
          "type": "quantitative"
        },
        "text": {
          "field": "Migration stream"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "titleFont": "Source Sans 3",
      "labelFont": "Source Sans 3"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
