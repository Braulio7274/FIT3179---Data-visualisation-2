{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dumbbell chart comparing the share of residents born overseas with the share who use a language other than English at home across Australian states and territories, 2021 Census.",

  "width": 700,
  "height": 380,
  "background": "#FFF7ED",

  "title": {
    "text": "How do migration and language diversity compare across Australia?",
    "subtitle": "Share of residents born overseas vs using a language other than English at home — 2021 Census",
    "anchor": "start",
    "font": "Space Grotesk",
    "fontSize": 22,
    "fontWeight": 700,
    "color": "#4A2545",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#655A67",
    "subtitlePadding": 8,
    "offset": 20
  },

  "data": {
    "url": "https://raw.githubusercontent.com/Braulio7274/FIT3179---Data-visualisation-2/refs/heads/main/state_diversity_dumbbell.csv",
    "format": {
      "type": "csv",
      "parse": {
        "overseas_percent": "number",
        "other_language_percent": "number",
        "overseas_born": "number",
        "uses_other_language": "number",
        "total_population": "number"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#B8BEC7",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "Western Australia",
            "Victoria",
            "New South Wales",
            "Australian Capital Territory",
            "South Australia",
            "Queensland",
            "Northern Territory",
            "Tasmania"
          ],
          "axis": {
            "title": null,
            "labelFont": "Source Sans 3",
            "labelFontSize": 12,
            "labelFontWeight": 500,
            "labelColor": "#655A67",
            "labelPadding": 8
          }
        },
        "x": {
          "field": "other_language_percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 35]
          },
          "axis": {
            "title": "Share of state/territory population (%)",
            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": 600,
            "titleColor": "#4A2545",
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelFontWeight": 400,
            "labelColor": "#655A67",
            "grid": true,
            "gridColor": "#DED3C8",
            "gridOpacity": 0.7,
            "tickCount": 8,
            "labelExpr": "datum.value + '%'",
            "domain": false,
            "tickColor": "#BDAFA8"
          }
        },
        "x2": {
          "field": "overseas_percent"
        }
      }
    },
    {
      "transform": [
        {
          "fold": ["overseas_percent", "other_language_percent"],
          "as": ["metric", "percentage"]
        },
        {
          "calculate": "datum.metric == 'overseas_percent' ? 'Born overseas' : 'Uses a language other than English at home'",
          "as": "metric_label"
        },
        {
          "calculate": "datum.metric == 'overseas_percent' ? datum.overseas_born : datum.uses_other_language",
          "as": "people"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "Western Australia",
            "Victoria",
            "New South Wales",
            "Australian Capital Territory",
            "South Australia",
            "Queensland",
            "Northern Territory",
            "Tasmania"
          ],
          "axis": null
        },
        "x": {
          "field": "percentage",
          "type": "quantitative",
          "scale": {
            "domain": [0, 35]
          },
          "axis": null
        },
        "color": {
          "field": "metric_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Born overseas",
              "Uses a language other than English at home"
            ],
            "range": [
              "#4472A8",
              "#D97B29"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "circle",
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelFontWeight": 400,
            "labelColor": "#655A67"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "metric_label",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Share of population",
            "format": ".1f"
          },
          {
            "field": "people",
            "type": "quantitative",
            "title": "People",
            "format": ","
          },
          {
            "field": "total_population",
            "type": "quantitative",
            "title": "Population",
            "format": ","
          }
        ]
      }
    }
  ],

  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },

  "config": {
    "font": "Source Sans 3",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Source Sans 3",
      "labelFontSize": 11,
      "labelFontWeight": 400,
      "labelColor": "#655A67",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#4A2545",
      "gridColor": "#DED3C8",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BDAFA8"
    },

    "legend": {
      "labelFont": "Source Sans 3",
      "labelFontSize": 11,
      "labelFontWeight": 400,
      "labelColor": "#655A67",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#4A2545"
    },

    "title": {
      "font": "Space Grotesk",
      "fontSize": 22,
      "fontWeight": 700,
      "color": "#4A2545",
      "subtitleFont": "Source Sans 3",
      "subtitleFontSize": 12,
      "subtitleFontWeight": 400,
      "subtitleColor": "#655A67"
    }
  }
}
